APP_NAME=ProcureAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker Compose: set APP_URL=http://localhost:8080 (nginx publishes APP_HTTP_PORT, default 8080)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# Host machine port when using Docker Compose (maps to MySQL 3306 in the container).
# Inside Compose services, DB_HOST=mysql and DB_PORT=3306 are set by docker-compose.yml.
DB_PORT=3306
DB_DATABASE=procure_ai
DB_USERNAME=procure
DB_PASSWORD=procure_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@procureai.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Drutogoti performance profiler (CaptureContext; no facade).
# When unset, enabled automatically if APP_ENV=production (see config/drutogoti.php).
# Set true locally to capture N+1 / slow queries; use queue storage in production.
DRUTOGOTI_ENABLED=false
DRUTOGOTI_STORAGE_DRIVER=queue
DRUTOGOTI_QUEUE_CONNECTION=database
DRUTOGOTI_SAMPLE_RATE=1.0

# Offline deterministic AI for demos/training (no external API keys required).
AI_DEMO_MODE=true

AI_HUB_DEFAULT_PROVIDER=openai
AI_HUB_OPENAI_API_KEY=
AI_HUB_ANTHROPIC_API_KEY=

PENNANT_STORE=database

# laravel-admin-panel path (defaults to ops-panel to avoid Filament /admin collision)
ADMIN_PANEL_PREFIX=ops-panel

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
